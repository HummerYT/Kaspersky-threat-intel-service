HTTP_ADDR=:8080
DATABASE_URL=postgres://threats:threats@localhost:5432/threats?sslmode=disable
# Leave empty to disable API-key authentication.
API_KEY=
# 0 disables rate limiting. Default is 120 requests per minute per client IP.
RATE_LIMIT=120
# Set both paths to enable HTTPS. Leave both empty for local HTTP development.
TLS_CERT_FILE=
TLS_KEY_FILE=
